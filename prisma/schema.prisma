generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  DISABLED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  DEAD_LETTER
}

model User {
  id              String           @id @db.Uuid
  email           String           @unique @db.VarChar(320)
  normalizedEmail String           @unique @map("normalized_email") @db.VarChar(320)
  displayName     String           @map("display_name") @db.VarChar(200)
  status          UserStatus       @default(ACTIVE)
  securityVersion Int              @default(1) @map("security_version")
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  credential      UserCredential?
  sessions        AuthSession[]
  roleAssignments UserRole[]

  @@map("users")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  status     String    @db.VarChar(30)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.Inet
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens     RefreshToken[]

  @@index([userId, status])
  @@map("auth_sessions")
}

model RefreshToken {
  id          String    @id @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest")
  pepperId    String    @map("pepper_id") @db.VarChar(100)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  session     AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Role {
  id          String      @id @db.Uuid
  code        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(150)
  description String?     @db.VarChar(500)
  status      RoleStatus  @default(ACTIVE)
  isSystem    Boolean     @default(false) @map("is_system")
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(150)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id            String   @id @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(150)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  targetType    String?  @map("target_type") @db.VarChar(100)
  targetId      String?  @map("target_id") @db.VarChar(150)
  outcome       String   @db.VarChar(30)
  reasonCode    String?  @map("reason_code") @db.VarChar(100)
  requestId     String?  @map("request_id") @db.VarChar(100)
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(200)
  version       Int
  aggregateType String?      @map("aggregate_type") @db.VarChar(100)
  aggregateId   String?      @map("aggregate_id") @db.VarChar(150)
  payload       Json
  headers       Json?
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt  DateTime?    @map("dispatched_at") @db.Timestamptz(3)
  lastAttemptAt DateTime?    @map("last_attempt_at") @db.Timestamptz(3)
  lockedBy      String?      @map("locked_by") @db.VarChar(150)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")

  @@index([status, availableAt, createdAt])
  @@map("outbox_events")
}

model JobFailure {
  id            String   @id @db.Uuid
  queueName     String   @map("queue_name") @db.VarChar(100)
  jobType       String   @map("job_type") @db.VarChar(150)
  externalJobId String?  @map("external_job_id") @db.VarChar(150)
  payload       Json?
  errorCode     String?  @map("error_code") @db.VarChar(100)
  errorMessage  String   @map("error_message")
  attempts      Int
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  failedAt      DateTime @default(now()) @map("failed_at") @db.Timestamptz(3)
  replayedAt    DateTime? @map("replayed_at") @db.Timestamptz(3)

  @@index([queueName, failedAt])
  @@map("job_failures")
}
