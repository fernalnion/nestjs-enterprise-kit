NODE_ENV=development
APP_ENV=development
SERVICE_NAME=enterprise-kit-api
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_BODY_LIMIT=1048576
HTTP_SHUTDOWN_GRACE_PERIOD=10s
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:4200
HTTP_CORS_ALLOW_CREDENTIALS=true
DATABASE_URL=postgresql://enterprise:enterprise@localhost:5432/enterprise_kit?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=enterprise-kit:development:
LOG_LEVEL=info
LOG_PRETTY_PRINT=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-kit-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
QUEUE_PREFIX=enterprise-kit:development
QUEUE_OUTBOX_CONCURRENCY=4
QUEUE_MAINTENANCE_CONCURRENCY=2
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=enterprise-kit
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_SESSION_IDLE_TTL=7d
AUTH_SESSION_ABSOLUTE_TTL=30d
AUTH_SIGNING_KEY_ID=local-development
AUTH_PRIVATE_KEY_REFERENCE=file://./.local/secrets/access-token-private.pem
AUTH_PUBLIC_KEYS_REFERENCE=file://./.local/secrets/access-token-public.pem
